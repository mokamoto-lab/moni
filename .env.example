# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_TOKEN=ntn_xxx

# ID of the Notion database that receives location entries (run `npm run setup` to create one)
NOTION_DATABASE_ID=

# Optional: require this password in the app before a location can be sent
APP_PASSWORD=

# Automatic updates (OwnTracks) are saved at most once per this many minutes. 0 saves every update.
MIN_INTERVAL_MINUTES=30

PORT=3000
