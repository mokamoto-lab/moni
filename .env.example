# Notion internal integration secret (https://www.notion.so/my-integrations)
# Never commit the real token.
NOTION_TOKEN=ntn_xxx

# 32-character database ID from the Notion URL (dashes optional).
# Example URL: https://www.notion.so/Your-DB-name-277d32ac11144ae6b93ae9f15cd3e6f5
NOTION_DATABASE_ID=

# Folder to scan and watch. Relative paths resolve from the current working directory.
SOURCE_FOLDER=./inbox
